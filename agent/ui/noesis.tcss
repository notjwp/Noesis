/* NOESIS.

   No hex anywhere in this file. Every colour is a variable from
   agent/ui/theme.py, because three themes only work if there is exactly one
   place a colour is written, and because transparency needs every foreground
   explicitly set - an unset one degrades to 16-colour ANSI and the palette is
   gone.

   Hierarchy comes from space and alignment. A terminal gives you bold, dim,
   reverse and colour, and that is the whole type system. */

Screen {
    background: $background;
    color: $foreground;
}

/* --- transparency ---------------------------------------------------------

   A TUI cannot make a window transparent; only the emulator can. What the app
   does is emit NO background, which `ansi_color=True` renders as a bare cell.
   Measured against textual 8.0.1: `background: transparent` alone still paints,
   and so does overriding App.render(); ansi_color plus transparent is the only
   combination that produces `default`, and an explicitly painted colour still
   survives it as truecolor.

   The class sits on the Screen, which IS the root of the widget tree. */

Screen.-gaps, Screen.-bare {
    background: transparent;
}

/* $muted over a busy wallpaper is hard to read and that cannot be fixed from
   inside the app, so in `bare` every muted role is promoted - the chrome
   included, since 2026-09-25, because nothing is painted under it any more.
   Naming the classes is the point: `Screen.-bare { color: $foreground }`
   inherits from a rule that already said so and promotes nothing. */
Screen.-bare .row--muted,
Screen.-bare Pane > .pane--title,
Screen.-bare Pane > .pane--count,
Screen.-bare #status,
Screen.-bare #status .status--hint,
Screen.-bare .hint,
Screen.-bare #key-shown,
Screen.-bare .row--empty {
    color: $foreground;
}

/* --- `bare`: nothing painted, anywhere ------------------------------------

   Every surface the two other modes fill. The list is here rather than beside
   each component so the invariant is checkable in one place, which is what the
   test asserts: in `bare` no cell carries $background, $surface or $panel.

   The CARET is the one exception, below. */
Screen.-bare #composer,
Screen.-bare #status,
Screen.-bare #landing-input,
Screen.-bare #approval,
Screen.-bare #plan,
Screen.-bare #setup,
Screen.-bare #choices,
Screen.-bare #base-url,
Screen.-bare #model-id,
Screen.-bare #key,
Screen.-bare #ask,
Screen.-bare #ask-answer,
Screen.-bare Button,
Screen.-bare Button:focus,
Screen.-bare Button.-error,
Screen.-bare .row--selected,
Screen.-bare Input > .input--selection,
/* Textual paints these itself, so OUR stylesheet never naming them is not the
   same as them being bare. Measured: RichLog#chat-log resolved to $surface in
   `bare` while every sibling was #00000000. Invisible on the landing screen,
   which has no RichLog - so it looked right until a chat opened. */
Screen.-bare RichLog,
Screen.-bare DataTable {
    background: transparent;
}

/* Scrollbars, which are read from the SCROLLABLE widget and not inherited, so
   both the Screen and the widgets need saying. The bar itself keeps its colour:
   a scrollbar with no trough and no bar is not a scrollbar. */
Screen.-bare,
Screen.-bare Pane, Screen.-bare RichLog, Screen.-bare DataTable {
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-background-active: transparent;
    scrollbar-corner-color: transparent;
}

/* Three cues that were carried by a fill and now are not. Selection was a
   background plus body text; a focused Button already said accent and bold, so
   only its fill goes; the destructive Button loses $error as a fill and takes
   it as text, because that hue is a safety property (see theme.py). */
Screen.-bare .row--selected {
    color: $accent;
}

Screen.-bare Button.-error {
    color: $error;
    text-style: bold;
}

Screen.-bare Input > .input--selection {
    color: $accent;
}

/* --- panes ---------------------------------------------------------------- */

Pane {
    background: $surface;
    color: $foreground;
    border: round $border;
    padding: 0 1;             /* vertical space is the scarce resource */
}

/* No motion is declared here on purpose. Textual 8.0.1's ANIMATABLE set
   (css/styles.py:226) has no border, so section 11's 120ms focus fade cannot be
   a transition and the border swap below is INSTANT. The open and close fades
   are per-event durations and belong with the event, not in a rule that would
   apply one timing to both. */

Pane:focus, Pane:focus-within {
    border: round $accent;
}

/* In `bare` the interiors go too. The focus BORDER is what marks a pane once
   the fill is gone, and it was already doing that job above. */
Screen.-bare Pane {
    background: transparent;
}

Pane > .pane--title {
    color: $muted;
    text-style: none;         /* lowercase and unemphasised, never bold */
}

Pane:focus > .pane--title,
Pane:focus-within > .pane--title {
    color: $accent;
}

Pane > .pane--count {
    color: $muted;
}

/* --- chrome ---------------------------------------------------------------

   Painted in ALL THREE modes. An approval prompt must never be hard to read,
   and the active step (FR-702) lives in the status bar. */

#chrome {
    dock: bottom;
    height: 2;
}

#composer {
    /* An Input is 3 rows by default, for a border it does not have here. Left
       at 3 it covers the status bar, and FR-702 lives in the status bar. */
    height: 1;
    background: $panel;
    color: $foreground;
    border: none;
    padding: 0 1;
}

#composer:focus {
    border: none;
}

#status {
    height: 1;
    background: $panel;
    color: $muted;
    padding: 0 1;
}

#status .status--step {
    color: $foreground;
}

#status .status--hint {
    color: $muted;
}

/* --- rows and selection ---------------------------------------------------

   Never `reverse`: it inverts unreadably in half the palettes and is illegible
   in the transparent modes. A background here, and in `bare` - where there is
   no background to give - the accent as text. */

.row--selected {
    background: $surface;
    color: $foreground;
}

.row--muted {
    color: $muted;            /* timestamps and durations, always */
}

.row--path {
    color: $info;
}

.row--ran {
    color: $foreground;
}

.row--mutated {
    color: $success;
}

.row--denied {
    color: $error;
}

.row--empty {
    color: $muted;
    text-align: center;       /* one dim line, never a blank box */
}

/* --- modals ---------------------------------------------------------------

   Filled in `opaque` and `gaps`; in `bare` the BORDER carries them, which is
   why every dialog below has one - thick $error for an approval, thick $accent
   for a question, round $border for the wizard. */

ApprovalScreen, PlanScreen {
    align: center middle;
}

#approval, #plan {
    width: 78;
    height: auto;
    padding: 1 2;
    background: $surface;
    color: $foreground;
}

#approval {
    border: thick $error;     /* the one place a second saturated hue belongs */
}

#plan {
    border: thick $accent;
}

#approval-title {
    color: $error;
    text-style: bold;
    margin-bottom: 1;
}

#plan-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

.arg {
    margin-left: 1;
    color: $foreground;
}

.step {
    margin-left: 1;
    color: $foreground;
}

.why {
    margin-top: 1;
    color: $muted;
}

#approval-buttons, #plan-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: center;
}

#approval-buttons Button, #plan-buttons Button {
    margin: 0 1;
}

/* --- the tiled region ------------------------------------------------------

   Panes are laid out by nested containers with fractional sizes, never
   absolute positions. The single gutter between two siblings is a margin on
   the FIRST of them, which is what puts a gap between panes and none on the
   outer edge - the same rule tiling.rects computes against. */

#tiled {
    height: 1fr;
}

/* PADDING, not margin, and the difference is the whole effect: a margin is
   painted by the PARENT, and a screen-owned empty region still resolves to
   $background even when the screen is transparent. Padding belongs to #tiled,
   which is transparent, so the cells come out bare. */
Screen.-gaps #tiled, Screen.-bare #tiled {
    padding: 1 1 0 1;
}

.gutter-right {
    margin-right: 1;
}

.gutter-below {
    margin-bottom: 1;
}

/* Focus is the workspace's own idea, not the terminal's: the composer holds
   keyboard focus so typing always reaches the agent, which means `:focus`
   would never land on a pane. */
Pane.-active {
    border: round $accent;
}

Pane.-active > .pane--title {
    color: $accent;
}

/* --- the landing ---------------------------------------------------------- */

LandingScreen {
    align: center middle;
}

#landing {
    width: 64;
    height: auto;
}

#logotype {
    height: auto;
    margin-bottom: 1;
}

.row--logo {
    color: $accent;
}

#landing-status {
    height: auto;
    margin-bottom: 1;
}

#landing-list {
    height: auto;
}

#landing-input {
    height: 1;
    background: $panel;
    color: $foreground;
    border: none;
    padding: 0 1;
    margin-top: 1;
}

#landing-hint {
    height: auto;
    padding: 0 1;
}

/* --- scrollbars -----------------------------------------------------------

   MEASURED: an unstyled ScrollBar rendered SOLID BLACK in all three modes.
   Section 10.1's rule is not advice - under ansi_color=True every colour must
   be set explicitly, and the scrollbar is the one widget nothing else styles. */

Screen {
    scrollbar-size: 1 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $border;
    scrollbar-color-hover: $muted;
    scrollbar-color-active: $accent;
    scrollbar-corner-color: $surface;
}

Screen.-bare {
    scrollbar-background: $panel;
    scrollbar-background-hover: $panel;
    scrollbar-background-active: $panel;
    scrollbar-corner-color: $panel;
}

/* Scrollbar colours are read from the SCROLLABLE widget, not inherited from
   the Screen - setting them there left the bar black. */
Pane, RichLog, DataTable {
    scrollbar-size: 1 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $border;
    scrollbar-color-hover: $muted;
    scrollbar-color-active: $accent;
    scrollbar-corner-color: $surface;
}

/* An Input's cursor and placeholder default to `reverse`, which under
   ansi_color=True is a 16-colour ANSI cell rather than a palette colour.

   THE CARET IS THE ONE CELL `bare` STILL PAINTS. Textual draws it as a
   background block, so transparent means no caret at all - a broken input
   rather than a look. */
Input > .input--cursor {
    background: $accent;
    color: $background;
}

Input > .input--placeholder,
Input > .input--suggestion {
    color: $muted;
}

Input > .input--selection {
    background: $surface;
    color: $foreground;
}

/* --- the setup wizard -----------------------------------------------------

   Here rather than on SetupApp, because the screen is pushed onto NoesisApp by
   ctrl+k and /setup as well as run standalone on first launch - and CSS on the
   App does not follow a screen to another App. Measured: opened from the
   landing, the wizard came up entirely unstyled. */

SetupScreen {
    align: center middle;
}

#setup {
    width: 78;
    height: auto;
    padding: 1 2;
    background: $surface;
    color: $foreground;
    border: round $border;
}

#setup-title {
    color: $accent;
    text-style: bold;
}

.hint {
    color: $muted;
    margin-bottom: 1;
}

#choices {
    height: auto;
    max-height: 18;
    margin-bottom: 1;
    background: $surface;
    color: $foreground;
    border: none;
}

#warning {
    height: auto;
    color: $warning;
}

#key-shown {
    height: auto;
    color: $muted;
}

#base-url, #model-id, #key {
    height: 1;
    background: $panel;
    color: $foreground;
    border: none;
    padding: 0 1;
    margin-top: 1;
}

#status {
    height: auto;
}

#after, #look {
    height: auto;
    margin-top: 1;
}

#after Button, #look Button {
    margin-right: 1;
}

/* Buttons take the palette rather than textual's defaults, which are unset
   colours and so degrade to 16-colour ANSI under ansi_color=True. */
Button {
    background: $panel;
    color: $foreground;
    border: none;
    height: 1;
    min-width: 12;
}

Button:focus {
    background: $surface;
    color: $accent;
    text-style: bold;
}

Button.-error {
    background: $error;
    color: $background;
}

/* The agent's own question. Same chrome as the approval modal, accent rather
   than error: it is asking, not warning. */
AskScreen {
    align: center middle;
}

#ask {
    width: 78;
    height: auto;
    padding: 1 2;
    background: $surface;
    color: $foreground;
    border: thick $accent;
}

#ask-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#ask-answer {
    height: 1;
    margin-top: 1;
    background: $panel;
    color: $foreground;
    border: none;
    padding: 0 1;
}
